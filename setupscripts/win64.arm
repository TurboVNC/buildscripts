CMAKE_BUILD_TYPE=Release

if [ "$1" = "-g" ]; then
	CMAKE_BUILD_TYPE=RelWithDebInfo
	shift
fi

cat <<EOF >win64-arm-toolchain.cmake
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
EOF

export JAVA_HOME=/opt/openjdk21.x64

CC=cl cmake -G"Ninja" -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
	-DCMAKE_JAVA_COMPILE_FLAGS='-target 16 -source 16 -Xlint:all,-serial,-unchecked,-rawtypes' \
	-DTVNC_INCLUDEJRE=1 \
	-DCMAKE_TOOLCHAIN_FILE=win64-arm-toolchain.cmake \
	-DTJPEG_INCLUDE_DIR=c:/libjpeg-turbo-arm64/include \
	-DTJPEG_LIBRARY=c:/libjpeg-turbo-arm64/lib/turbojpeg-static.lib \
	-DTVNC_JDK_MODULE_PATH=/opt/openjdk21.arm64/jmods \
	-DJAVA_AWT_INCLUDE_PATH=/opt/openjdk21.arm64/include \
	-DJAVA_AWT_LIBRARY=/opt/openjdk21.arm64/lib/jawt.lib \
	-DJAVA_INCLUDE_PATH=/opt/openjdk21.arm64/include \
	-DJAVA_INCLUDE_PATH2=/opt/openjdk21.arm64/include/win32 \
	-DJAVA_JVM_LIBRARY=/opt/openjdk21.arm64/lib/jvm.lib \
	-DCMAKE_EXE_LINKER_FLAGS="/machine:ARM64 /subsystem:console,6.02" \
	-DCMAKE_MODULE_LINKER_FLAGS="/machine:ARM64 /subsystem:console,6.02" \
	-DCMAKE_SHARED_LINKER_FLAGS="/machine:ARM64 /subsystem:console,6.02" \
	.. ${1+"$@"}
